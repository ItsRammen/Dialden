# Copy this file to .env before running Docker Compose on the Windows host.
TOASTTV_TV_PATH=Z:/TV Shows
TOASTTV_MOVIE_PATH=Z:/Movies
# Writable library for bumpers, idents, fillers, and standby loops.
TOASTTV_STATION_ASSETS_PATH=./media/interludes
TOASTTV_LIBRARY_POLICY_PATH=./config/kids-7.library.json
TZ=Asia/Taipei
TOASTTV_PORT=1993
# Server transcoder: software (default), auto, or intel-qsv. Intel modes need a
# native Linux host plus the /dev/dri mapping in docker-compose.qsv.yml;
# Docker Desktop on Windows cannot expose Intel Quick Sync to this container.
TOASTTV_TRANSCODING_MODE=software
# FFmpeg needs a render node here, not the mapped /dev/dri directory. Set this
# to /dev/dri only when you want ToastTV to try every renderD* node (multi-GPU).
TOASTTV_QSV_DEVICE=/dev/dri/renderD128
# Optional first-start defaults. Prefer Settings > Metadata in the running app;
# values saved there live in appdata and override these variables after restart.
# Without a key, every new collection remains in Needs Review.
TMDB_API_KEY=
TMDB_LANGUAGE=en-US
RATING_REGION=US
# Comma-separated ISO country codes, for example: AU,GB
# Consulted in order when the preferred region carries no certification.
# Leave empty for US-only, which parks unrated titles in the decision queue.
RATING_FALLBACK_REGIONS=GB,CA,AU,IE
# Keep loopback for local administration. Use 0.0.0.0 only on a trusted LAN.
TOASTTV_BIND_ADDRESS=127.0.0.1
